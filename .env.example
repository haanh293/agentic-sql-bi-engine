# ==============================================================================
# Self-Healing Agentic Text-to-SQL & BI Analytics Engine - Environment Config
# ==============================================================================

# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# SQLite Database
DB_PATH=ecommerce.db
SEED_ON_STARTUP=true

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
# NOTE: Leave empty to enable Smart Deterministic Fallback Mode for offline tests
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# Agent & Security Guard Limits
MAX_SELF_HEAL_ATTEMPTS=3
DEFAULT_QUERY_LIMIT=100
MAX_QUERY_LIMIT=500
